# ---------------------------------------------------------------------------
# ms-negocio-bpm - copy this file to .env and adjust the values
# Never commit real credentials.
# ---------------------------------------------------------------------------

PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=replace-with-a-32-characters-long-random-key
APP_NAME=ms-negocio
DRIVE_DISK=local

# Database
DB_CONNECTION=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB_NAME=modulos
MYSQL_SSL=false
# Only used when MYSQL_SSL=true
MYSQL_SSL_CERT=./cert/DigiCertGlobalRootCA.crt.pem

# CORS - origin allowed to call this API
CORS_ORIGIN=http://localhost:4200

# JWT - must match JWT_SECRET in ms-security. Minimum 64 bytes (HS512).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef0123456789abcdef

# Notification / certificate microservice
MS_CORREOS=http://127.0.0.1:5000

# Shared secret for the GET /alarms/check automation endpoint
ALARM_SECRET_TOKEN=change-me-alarm-secret

# ePayco merchant credentials, used to verify webhook signatures
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
